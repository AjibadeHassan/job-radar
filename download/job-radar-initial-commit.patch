+}
+
+.dark {
+  --background: oklch(0.13 0.015 165);
+  --foreground: oklch(0.95 0.01 145);
+  --card: oklch(0.18 0.02 165);
+  --card-foreground: oklch(0.95 0.01 145);
+  --popover: oklch(0.18 0.02 165);
+  --popover-foreground: oklch(0.95 0.01 145);
+  --primary: oklch(0.7 0.15 160);
+  --primary-foreground: oklch(0.13 0.015 165);
+  --secondary: oklch(0.22 0.025 165);
+  --secondary-foreground: oklch(0.95 0.01 145);
+  --muted: oklch(0.22 0.025 165);
+  --muted-foreground: oklch(0.7 0.02 150);
+  --accent: oklch(0.28 0.05 165);
+  --accent-foreground: oklch(0.95 0.01 145);
+  --destructive: oklch(0.7 0.19 22);
+  --border: oklch(1 0 0 / 10%);
+  --input: oklch(1 0 0 / 15%);
+  --ring: oklch(0.7 0.15 160);
+  --chart-1: oklch(0.7 0.16 160);
+  --chart-2: oklch(0.75 0.15 85);
+  --chart-3: oklch(0.65 0.2 25);
+  --chart-4: oklch(0.6 0.12 200);
+  --chart-5: oklch(0.75 0.18 300);
+  --sidebar: oklch(0.18 0.02 165);
+  --sidebar-foreground: oklch(0.95 0.01 145);
+  --sidebar-primary: oklch(0.7 0.15 160);
+  --sidebar-primary-foreground: oklch(0.13 0.015 165);
+  --sidebar-accent: oklch(0.22 0.025 165);
+  --sidebar-accent-foreground: oklch(0.95 0.01 145);
+  --sidebar-border: oklch(1 0 0 / 10%);
+  --sidebar-ring: oklch(0.7 0.15 160);
+}
+
+@layer base {
+  * {
+    @apply border-border outline-ring/50;
+  }
+  body {
+    @apply bg-background text-foreground;
+  }
+}
+
+/* Radar scope aesthetic — subtle pulse for the radar dot */
+@keyframes radar-pulse {
+  0%, 100% { transform: scale(1); opacity: 1; }
+  50% { transform: scale(1.4); opacity: 0.6; }
+}
+
+@keyframes radar-sweep {
+  from { transform: rotate(0deg); }
+  to { transform: rotate(360deg); }
+}
+
+@keyframes radar-ring {
+  0% { transform: scale(0.6); opacity: 0.8; }
+  100% { transform: scale(2.5); opacity: 0; }
+}
+
+.radar-dot { animation: radar-pulse 2s ease-in-out infinite; }
+.radar-sweep { animation: radar-sweep 4s linear infinite; transform-origin: center; }
+.radar-ring { animation: radar-ring 3s ease-out infinite; }
+
+/* Custom scrollbar for long lists */
+.scroll-thin::-webkit-scrollbar { width: 6px; height: 6px; }
+.scroll-thin::-webkit-scrollbar-track { background: transparent; }
+.scroll-thin::-webkit-scrollbar-thumb { background: oklch(0.5 0.03 160 / 0.3); border-radius: 3px; }
+.scroll-thin::-webkit-scrollbar-thumb:hover { background: oklch(0.5 0.03 160 / 0.5); }
+
+/* Grid pattern for hero */
+.grid-pattern {
+  background-image:
+    linear-gradient(oklch(0.55 0.14 165 / 0.06) 1px, transparent 1px),
+    linear-gradient(90deg, oklch(0.55 0.14 165 / 0.06) 1px, transparent 1px);
+  background-size: 32px 32px;
+}
+
+.dark .grid-pattern {
+  background-image:
+    linear-gradient(oklch(0.7 0.15 160 / 0.06) 1px, transparent 1px),
+    linear-gradient(90deg, oklch(0.7 0.15 160 / 0.06) 1px, transparent 1px);
+}
